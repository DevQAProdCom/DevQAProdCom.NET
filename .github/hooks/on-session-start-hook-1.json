{
  "hooks": {
    "sessionStart": [
      {
        "custom-metadata": {
          "identifier": "on-session-start-hook-1",
          "data": [
            {
              "directory": "scripts",
              "files": [
                "scripts/on-session-start-hook-1.ps1"
              ]
            }
          ]
        },
        "type": "command",
        "powershell": ".github/hooks/scripts/on-session-start-hook-1.ps1",
        "timeoutSec": 30
      }
    ]
  }
}